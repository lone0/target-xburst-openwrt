+MODULE_AUTHOR("Reimu NotMoe <reimu@sudomaker.com>");
+MODULE_DESCRIPTION("User mode SPI device interface with zero copy");
+MODULE_LICENSE("GPL");
+MODULE_ALIAS("spi:spidev_zerocopy");
