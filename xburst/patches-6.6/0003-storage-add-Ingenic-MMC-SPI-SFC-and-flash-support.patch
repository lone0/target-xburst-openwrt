+			 msc_readl(host, ARG),
+			 msc_readl(host, RES),
+			 msc_readl(host, LPM),
+			 msc_readl(host, DMAC),
+			 msc_readl(host, DMANDA),
+			 msc_readl(host, DMADA),
+			 msc_readl(host, DMALEN),
