From 551b1fb3b6f6bb65bad557755bbcbe84e54cbfec Mon Sep 17 00:00:00 2001
From: Zhen XIN <lone.zen6@gmail.com>
Date: Tue, 25 Aug 2026 03:07:12 +0800
Subject: [PATCH 07/14] clk: ingenic: do not expose mux ops on plain PLLs

The custom CGU merge attached set_parent to every PLL even though plain PLLs have no mux and no determine_rate callback. Linux 6.6 rejects that invalid operations set during early clock registration, preventing the X2000 CGU and timers from probing.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 drivers/clk/ingenic/cgu.c | 10 ++--------
 1 file changed, 2 insertions(+), 8 deletions(-)

diff --git a/drivers/clk/ingenic/cgu.c b/drivers/clk/ingenic/cgu.c
index a1968ed749d0..56f57361faa0 100644
--- a/drivers/clk/ingenic/cgu.c
+++ b/drivers/clk/ingenic/cgu.c
@@ -24,9 +24,6 @@
 
 #define MHZ (1000 * 1000)
 
-static u8 ingenic_clk_get_parent(struct clk_hw *hw);
-static int ingenic_clk_set_parent(struct clk_hw *hw, u8 idx);
-
 static inline const struct ingenic_cgu_clk_info *
 to_clk_info(struct ingenic_clk *clk)
 {
@@ -90,7 +87,7 @@ ingenic_pll_recalc_rate(struct clk_hw *hw, unsigned long parent_rate)
 	bool bypass;
 	u32 ctl;
 
-	BUG_ON(!(clk_info->type == CGU_CLK_PLL || clk_info->type == (CGU_CLK_PLL | CGU_CLK_MUX)));
+	BUG_ON(clk_info->type != CGU_CLK_PLL);
 	pll_info = &clk_info->pll;
 
 	ctl = readl(cgu->base + pll_info->reg);
@@ -318,9 +315,6 @@ static int ingenic_pll_is_enabled(struct clk_hw *hw)
 }
 
 static const struct clk_ops ingenic_pll_ops = {
-	.get_parent = ingenic_clk_get_parent,
-	.set_parent = ingenic_clk_set_parent,
-
 	.recalc_rate = ingenic_pll_recalc_rate,
 	.round_rate = ingenic_pll_round_rate,
 	.set_rate = ingenic_pll_set_rate,
@@ -751,7 +745,7 @@ static int ingenic_register_clock(struct ingenic_cgu *cgu, unsigned idx)
 
 		caps &= ~CGU_CLK_PLL;
 
-		if (caps && caps != CGU_CLK_MUX) {
+		if (caps) {
 			pr_err("%s: PLL may not be combined with type 0x%x\n",
 			       __func__, caps);
 			goto out;
