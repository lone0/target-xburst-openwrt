+            memcpy(&ivcw->iv[0], &m->partialMD5[0], 16);
+            memcpy(&ivcw->iv[2], &m->partialMD5[0], 16);
+            loop_compute_md5_iv_v3_2x(devSect, (u_int32_t *)(&ivcw->iv[0]), (u_int32_t *)(&raw_buf[16]));
+            a = m->keyPtr[((unsigned)devSect    ) & y];
+            padlock_flush_key_context();
