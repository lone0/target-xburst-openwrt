+            a = m->keyPtr[((unsigned)devSect + 1) & y];
+            padlock_flush_key_context();
+            padlock_rep_xcryptcbc(&ivcw->cw[0], &a->aes_d_key[0], raw_buf + 512, loop_buf + 512, &ivcw->iv[2], 32);
+            /* compute correct IV */
+            memcpy(&ivcw->iv[0], &m->partialMD5[0], 16);
