+		1 0x3a 2 0x06 // RGB888
+		1 0xb2 2 0x01 2 0x01 2 0x00 2 0x33 2 0x33
+		1 0xb7 2 0x35
+		1 0xbb 2 0x28
+		1 0xc0 2 0x2c
+		1 0xc2 2 0x01
+		1 0xc3 2 0x0b
+		1 0xc4 2 0x20
+		1 0xc6 2 0x05 // Frame Rate Control in Normal Mode
+		1 0x0e 2 0x00 2 0x80 // TE enable
+		1 0xd0 2 0xa4 2 0xa1
+		1 0x29 // Display on
