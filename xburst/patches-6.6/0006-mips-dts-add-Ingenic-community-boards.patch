+		compatible = "ti,bq25890";
+		reg = <0x6a>;
+
+		interrupt-parent = <&gpa>;
+		interrupts = <7 IRQ_TYPE_EDGE_FALLING>;
+		wakeup-source;
+
+		ti,battery-regulation-voltage = <4200000>;
+		ti,charge-current = <500000>;
+		ti,termination-current = <25000>;
+		ti,precharge-current = <50000>;
+		ti,minimum-sys-voltage = <3600000>;
+		ti,boost-voltage = <5100000>;
+		ti,boost-max-current = <2400000>;
+		ti,thermal-regulation-threshold = <120>;
+	};
+};
+
+
+&sfc {
+	status = "okay";
+
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_sfc>;
+
+	flash: spinor@0 {
+		compatible = "jedec,spi-nor";
+		spi-max-frequency = <133000000>;
+		reg = <0>;
+
+		spi-rx-bus-width = <4>;
+		spi-tx-bus-width = <4>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			uboot@0 {
+				reg = <0x0 0x40000>;
+			};
+
+			kernel@40000 {
+				reg = <0x40000 0x300000>;
+			};
+
+			rootfs@840000 {
+				reg = <0x340000 0x10000000>;
+			};
+		};
+	};
+
+};
+
+&msc1 {
+	status = "okay";
+
+	bus-width = <4>;
+	max-frequency = <25000000>;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_msc0>;
+
+	/delete-property/ dmas;
+	/delete-property/ dma-names;
+
+	non-removable;
+};
+
+&msc0 {
+		status = "okay";
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+		bus-width = <4>;
+		max-frequency = <25000000>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_msc1>;
+
+		non-removable;
+		cap-power-off-card;
+		keep-power-in-suspend;
+		wakeup-source;
+
+		ap6212a: wifi@1 {
+				compatible = "brcm,bcm4329-fmac";
+				reg = <1>;
+
+				interrupt-parent = <&gpc>;
+				interrupts = <16 IRQ_TYPE_EDGE_FALLING>;
+				interrupt-names = "host-wake";
+				wakeup-source;
+
+				// reset-gpios = <&gpc 17 GPIO_ACTIVE_LOW>;
+
+				brcm,drive-strength = <10>;
+		};
+};
+
+&otg_phy {
+	status = "okay";
+};
+
+&otg {
+	status = "okay";
+};
+
+&pwm {
+	status = "okay";
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_pwm4>;
+};
+
+&pinctrl {
+
+	pins_rtc32k: rtc32k {
+		function = "rtc32k";
+		groups = "rtc32k";
+	};
+
+	pins_pwm4: pwm4 {
+		function = "pwm4";
+		groups = "pwm4";
+	};
+
+	pins_sfc: sfc {
+		function = "sfc";
+		groups = "sfc-data", "sfc-clk", "sfc-ce";
+	};
+
+	pins_spi0: spi0 {
+			function = "ssi";
+			groups = "ssi-dt-d", "ssi-dr-d", "ssi-clk-d", "ssi-ce0-d";
+	};
+
+	pins_uart0: uart0 {
+		function = "uart0";
+		groups = "uart0-data", "uart0-hwflow";
+		bias-pull-up;
+	};
+
+	pins_uart2: uart2 {
+		function = "uart2";
+		groups = "uart2-data-d";
+		bias-pull-up;
+	};
+
+	pins_i2c0: i2c0 {
+		function = "i2c0";
+		groups = "i2c0-data";
+		bias-pull-up;
+	};
+
+	pins_msc0: msc0 {
+		function = "mmc0";
+		groups = "mmc0-1bit", "mmc0-4bit";
+		bias-pull-up;
+	};
+
+	pins_msc1: msc1 {
+		function = "mmc1";
+		groups = "mmc1-1bit", "mmc1-4bit";
+		bias-pull-up;
+	};
+
+};
diff --git a/arch/mips/boot/dts/ingenic/wireless-terminal.dts b/arch/mips/boot/dts/ingenic/wireless-terminal.dts
new file mode 100644
index 000000000000..89b1c58a0fe3
--- /dev/null
+++ b/arch/mips/boot/dts/ingenic/wireless-terminal.dts
@@ -0,0 +1,199 @@
+// SPDX-License-Identifier: GPL-2.0
+/dts-v1/;
+
+#include "x1501.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/clock/ingenic,sysost.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/ {
+	compatible = "sudomaker,wireless-terminal", "ingenic,x1501";
+	model = "SudoMaker Wireless Terminal";
+
+	aliases {
+		serial2 = &uart2;
+	};
+
+	chosen {
+		// bootargs = "console=null mem=8M@0x0 loglevel=7 ingenic_pm_clk=0 devtmpfs.mount=1 lo_prealloc=4 clk_ignore_unused no_hash_pointers";
+		bootargs = "console=ttyS2,115200n8 mem=8M@0x0 loglevel=7 ingenic_pm_clk=0 devtmpfs.mount=1 lo_prealloc=4 clk_ignore_unused no_hash_pointers";
+		stdout-path = "serial2:115200n8";
+	};
+
+	memory {
+		device_type = "memory";
+		reg = <0x0 0x800000>;
+	};
+
+	clk_11059200: clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <11059200>;
+		clock-accuracy = <100>;
+	};
+};
+
+&exclk {
+	clock-frequency = <24000000>;
+};
+
+&cgu {
+	assigned-clocks = <&cgu X1000_CLK_SSIMUX>, <&cgu X1000_CLK_RTC>;
+	assigned-clock-parents = <&cgu X1000_CLK_SSIPLL_DIV2>, <&cgu X1000_CLK_EXCLK_DIV512>;
+};
+
+&ost {
+	/* 1500 kHz for the system timer and clocksource */
+	assigned-clocks = <&ost OST_CLK_EVENT_TIMER>, <&ost OST_CLK_GLOBAL_TIMER>;
+	assigned-clock-rates = <1500000>, <1500000>;
+};
+
+&ssi {
+	status = "okay";
+
+	// MPLL = 600MHz
+	assigned-clocks = <&cgu X1000_CLK_SSIPLL>;
+	assigned-clock-rates = <200000000>;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_spi0>;
+
+	num-cs = <3>;
+	cs-gpios = <0>, <&gpa 12 GPIO_ACTIVE_LOW>, <&gpa 11 GPIO_ACTIVE_LOW>;
+
+	psram: ly68@0 {
+		reg = <0>;
+		compatible = "lyontek,ly68l6400";
+
+		spi-max-frequency = <50000000>;
+		lyontek,rx-max-frequency = <25000000>;
+		// 85 degrees C rating
+		lyontek,op-sleep-ratio = <30>;
+		// 105 degrees C rating, but the plastic shell will melt?
+		// lyontek,op-sleep-ratio = <8>;
+	};
+
+	lcd: uc1638@1 {
+		reg = <1>;
+		compatible = "sudomaker,spidev-zerocopy";
+
+		spi-max-frequency = <16000000>;
+	};
+
+	lora: sx126x@2 {
+		reg = <2>;
+		compatible = "sudomaker,spidev-zerocopy";
+
+		spi-max-frequency = <8000000>;
+	};
+};
+
+&uart1 {
+	status = "okay";
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_uart1>;
+};
+
+&uart2 {
+	status = "okay";
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_uart2>;
+};
+
+&audio {
+	status = "okay";
+};
+
+&i2c1 {
+	status = "okay";
+
+	clock-frequency = <200000>;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_i2c1>;
+
+	rtc_ext: rx8900@32 {
+		compatible = "epson,rx8900";
+		reg = <0x32>;
+
+		interrupt-parent = <&gpa>;
+		interrupts = <16 IRQ_TYPE_EDGE_FALLING>;
+		wakeup-source;
+
+		epson,vdet-disable;
+		trickle-diode-disable;
+	};
+
+	uart_exp: sc16is752@4d {
+		compatible = "nxp,sc16is752";
+		reg = <0x4d>;
+
+		clocks = <&clk_11059200>;
+
+		interrupt-parent = <&gpa>;
+		interrupts = <15 IRQ_TYPE_EDGE_FALLING>;
+		wakeup-source;
+
+		gpio-controller;
+		#gpio-cells = <2>;
+
+		nxp,porta-as-gpio;
+		nxp,portb-as-gpio;
+	};
+};
+
+&msc1 {
+	status = "okay";
+
+	bus-width = <4>;
+	max-frequency = <50000000>;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_msc1>;
+
+	non-removable;
+};
+
+&otg_phy {
+	status = "okay";
+};
+
+&otg {
+	status = "okay";
+};
+
+&pinctrl {
+	pins_spi0: spi0 {
+		function = "ssi";
+		groups = "ssi-dt-d", "ssi-dr-d", "ssi-clk-d", "ssi-ce0-d";
+		bias-disable;
+	};
+
+	pins_uart2: uart2 {
+		function = "uart2";
+		groups = "uart2-data-a";
+		bias-pull-up;
+	};
+
+	pins_uart1: uart1 {
+		function = "uart1";
+		groups = "uart1-data-a", "uart1-hwflow";
+		bias-pull-up;
+	};
+
+	pins_i2c1: i2c1 {
+		function = "i2c1";
+		groups = "i2c1-data-a";
+		bias-pull-up;
+	};
+
+	pins_msc1: msc1 {
+		function = "mmc1";
+		groups = "mmc1-1bit", "mmc1-4bit";
+		bias-pull-up;
+	};
+
+};
